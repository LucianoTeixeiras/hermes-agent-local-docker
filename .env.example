# Docker image
HERMES_IMAGE_TAG=latest

# Local binding. Keep 127.0.0.1 unless you intentionally expose Hermes on a network.
API_SERVER_BIND=127.0.0.1
API_SERVER_PORT=8642
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=9119

# Required. Generate with:
#   openssl rand -hex 32
# PowerShell alternative:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Minimum 0 -Maximum 256) })
API_SERVER_KEY=replace-with-a-strong-random-key-minimum-8-chars
API_SERVER_ENABLED=true
API_SERVER_CORS_ORIGINS=http://127.0.0.1:9119,http://localhost:9119

# Gateway user access control for messaging platforms.
# API_SERVER_KEY protects the HTTP API. These variables control which users can
# interact with Hermes through Telegram, Discord, Slack, Google Chat, etc.
# For local-only testing you may set GATEWAY_ALLOW_ALL_USERS=true.
# For real use, keep it false and configure explicit allowlists.
GATEWAY_ALLOW_ALL_USERS=false
GATEWAY_ALLOWED_USERS=
TELEGRAM_ALLOWED_USERS=
DISCORD_ALLOWED_USERS=
SLACK_ALLOWED_USERS=
GOOGLE_CHAT_ALLOWED_USERS=
WHATSAPP_ALLOWED_USERS=
SIGNAL_ALLOWED_USERS=
MATRIX_ALLOWED_USERS=

# Telegram bot integration.
# Create the bot with @BotFather and put the token here.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id, not your @username. Comma-separated for many.
# Example: TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_ALLOWED_CHATS=
TELEGRAM_GROUP_ALLOWED_CHATS=
TELEGRAM_OBSERVE_UNMENTIONED_GROUP_MESSAGES=false
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=
TELEGRAM_CRON_THREAD_ID=
TELEGRAM_PROXY=
# Polling is the recommended local/default mode. Use webhook only for public HTTPS deployments.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PORT=8443

# Dashboard is disabled by default because the official image fails closed without OAuth.
# To enable safely, configure HERMES_DASHBOARD=1 and HERMES_DASHBOARD_OAUTH_CLIENT_ID.
HERMES_DASHBOARD=0
HERMES_DASHBOARD_OAUTH_CLIENT_ID=

# Only use this behind your own authentication layer or on a fully trusted LAN.
HERMES_DASHBOARD_INSECURE=

# Resource limits
HERMES_CPUS=2.0
HERMES_MEMORY=4G

# Data persistence mode for Linux/WSL helper scripts.
# bind   = ./hermes-data:/opt/data
# volume = Docker named volume, recommended for WSL projects under /mnt/c,
#          OneDrive, or Windows-backed filesystems.
HERMES_DATA_MODE=bind
HERMES_DATA_VOLUME=hermes-agent-data

# -----------------------------------------------------------------------------
# Hermes provider model API keys
# -----------------------------------------------------------------------------
# These variables are passed into the Hermes container by docker-compose.yml.
# For long-lived Hermes-native configuration, the official Hermes location is
# hermes-data/.env, created during setup and mapped to /opt/data/.env.
#
# Keep API keys empty unless you use the provider.
# Base URLs below are prefilled when the Hermes docs or provider docs publish
# a stable default. Leave them as-is unless you need a proxy, region, local
# gateway, self-hosted endpoint, or corporate API gateway.

# Recommended aggregator / flexible routing
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HERMES_OPENROUTER_CACHE=
HERMES_OPENROUTER_CACHE_TTL=

# Nous Portal / Nous inference
NOUS_BASE_URL=https://portal.nousresearch.com
NOUS_INFERENCE_BASE_URL=https://inference.nousresearch.com/v1
HERMES_PORTAL_BASE_URL=https://portal.nousresearch.com
HERMES_NOUS_MIN_KEY_TTL_SECONDS=
HERMES_NOUS_TIMEOUT_SECONDS=

# OpenAI-compatible endpoints. Use the official OpenAI URL, or replace with
# VLLM, SGLang, LM Studio, LocalAI, LiteLLM, Open WebUI, or another gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# GitHub Copilot provider
COPILOT_GITHUB_TOKEN=
GH_TOKEN=
GITHUB_TOKEN=
HERMES_COPILOT_ACP_COMMAND=
COPILOT_CLI_PATH=
HERMES_COPILOT_ACP_ARGS=
COPILOT_ACP_BASE_URL=

# Anthropic / Claude
ANTHROPIC_API_KEY=
ANTHROPIC_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

# Google Gemini / AI Studio
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
HERMES_GEMINI_CLIENT_ID=
HERMES_GEMINI_CLIENT_SECRET=
HERMES_GEMINI_PROJECT_ID=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# xAI / Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# Mistral
MISTRAL_API_KEY=

# Hugging Face Inference Providers
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1

# AWS Bedrock
AWS_REGION=us-east-1
AWS_PROFILE=
BEDROCK_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com

# Azure Foundry / Azure OpenAI / Azure Anthropic
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BASE_URL=
AZURE_ANTHROPIC_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_FEDERATED_TOKEN_FILE=
AZURE_AUTHORITY_HOST=

# Qwen / Alibaba DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
HERMES_QWEN_BASE_URL=https://portal.qwen.ai/v1

# Kimi / Moonshot
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_CN_API_KEY=

# z.ai / ZhipuAI GLM
GLM_API_KEY=
ZAI_API_KEY=
Z_AI_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# MiniMax
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_CN_API_KEY=
MINIMAX_CN_BASE_URL=https://api.minimaxi.com/anthropic

# NovitaAI
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/openai/v1

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Ollama Cloud or custom Ollama-compatible endpoint
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1

# Other supported model providers
ARCEEAI_API_KEY=
ARCEE_BASE_URL=https://api.arcee.ai/api/v1
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
KILOCODE_API_KEY=
KILOCODE_BASE_URL=https://api.kilo.ai/api/gateway
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
TOKENHUB_API_KEY=
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com/v1
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=

# Process-level model override. Prefer hermes-data/config.yaml for normal use.
HERMES_MODEL=
